{
  "name": "workspace",
  "version": "0.0.0",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:task10": "pnpm --filter @workspace/al-aqsa-camp-mobile test && pnpm --filter @workspace/al-aqsa-camp test && pnpm --filter @workspace/api-server test",
    "test:task10:browser": "playwright test --config playwright.task10.config.ts",
    "test:task48:browser": "playwright test --config playwright.task48.config.ts",
    "test:task98:browser": "playwright test --config playwright.task98.config.ts",
    "test:task121:browser": "playwright test --config playwright.task121.config.ts",
    "test:task144:browser": "playwright test --config playwright.task144.config.ts",
    "test:task145:browser": "playwright test --config playwright.task145.config.ts",
    "test:task147:browser": "playwright test --config playwright.task147.config.ts",
    "test:mobile-role-journeys:browser": "playwright test --config playwright.mobile-role-journeys.config.ts",
    "test:task162:browser": "playwright test --config playwright.task162.config.ts",
    "test:task163:browser": "playwright test --config playwright.task163.config.ts",
    "test:workspace-failures:browser": "playwright test --config playwright.workspace-failures.config.ts",
    "test:task60:browser": "playwright test --config playwright.task60.config.ts",
    "test:task265:browser": "playwright test --config playwright.task265.config.ts",
    "test:task273:browser": "playwright test --config playwright.task273.config.ts",
    "test:task186:native-auth:ios": "bash artifacts/api-server/e2e/run-mobile-native-auth-large-text.sh ios",
    "test:task186:native-auth:android": "bash artifacts/api-server/e2e/run-mobile-native-auth-large-text.sh android",
    "test:task193:native-auth:ios": "bash artifacts/api-server/e2e/run-mobile-native-auth-large-text.sh ios",
    "test:task193:native-auth:android": "bash artifacts/api-server/e2e/run-mobile-native-auth-large-text.sh android",
    "test:task194:native-auth:ios": "MAESTRO_FLOW=mobile-native-auth-connection-failure.yaml bash artifacts/api-server/e2e/run-mobile-native-auth-large-text.sh ios",
    "test:task194:native-auth:android": "MAESTRO_FLOW=mobile-native-auth-connection-failure.yaml bash artifacts/api-server/e2e/run-mobile-native-auth-large-text.sh android"
  },
  "private": true,
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
